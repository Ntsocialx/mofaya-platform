# Copy to server/.env for local development.
# On Render: add the same keys under Service > Environment (don't upload this file).

NODE_ENV=development
# Render sets PORT automatically — leave it out there. Used locally only.
PORT=4000

# Frontend URL(s) allowed to call this API (CORS). Comma-separate several, no trailing slash.
# Local:      http://localhost:3000
# Production: https://mofaya-platform.vercel.app (and/or your custom domain)
NEXT_PUBLIC_URL=http://localhost:3000
# Optional: also allow this Vercel project's preview deployments, e.g. mofaya-platform
VERCEL_PROJECT_NAME=

# Secret for signing JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Neon Postgres connection string (Neon console > Connection Details). Keep ?sslmode=require.
# e.g. postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Form proxy.
# Action URL: https://docs.google.com/forms/d/e/{FORM_ID}/formResponse
# Entry keys: open the form > ⋮ > "Get pre-filled link", fill every field, copy the link,
# and read each entry.{FIELD_ID} from its query string. Use the full key, e.g. entry.123456789
GOOGLE_FORM_ACTION_URL=
GOOGLE_FORM_ENTRY_FIRST_NAME=
GOOGLE_FORM_ENTRY_SURNAME=
GOOGLE_FORM_ENTRY_EMAIL=
GOOGLE_FORM_ENTRY_PHONE=
GOOGLE_FORM_ENTRY_INSTITUTION=
GOOGLE_FORM_ENTRY_FACULTY=
GOOGLE_FORM_ENTRY_STUDY_YEAR=
GOOGLE_FORM_ENTRY_STUDENT_NUMBER=
GOOGLE_FORM_ENTRY_PORTFOLIO_URL=
